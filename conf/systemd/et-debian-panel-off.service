[Unit]
Description=et-debian: power off physical panel (keep machine awake for RDP)
After=multi-user.target
# After greeter has claimed the seat so we blank the lit laptop lid.
After=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/et-debian-panel-off
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
