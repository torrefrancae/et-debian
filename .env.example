# Copy to private/.env on the machine (never commit).
# Used only by optional local wrappers — bootstrap prompts or reads root via su.
ET_HOSTNAME=et-debian
ET_TIMEZONE=Asia/Manila
# Extra users are OFF by default (host keeps et + root only).
CREATE_ETSHARE=0
CREATE_ET_DEV=0
CREATE_ET_STARTUP=0
# Scrin.io Linux .deb (amd64). Override if you have a newer dashboard download.
# SCRIN_DEB_URL=https://raw.githubusercontent.com/tickernelz/scrin_io/master/scrin.io-amd64.deb
# SCRIN_USE_LEGACY=1  # old mono Screenshot Monitor instead
